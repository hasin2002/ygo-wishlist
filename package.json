    "test:purchase-accounting-audit": "node --test tests/ordinary-purchase-accounting-audit.test.mjs tests/sealed-unit-cost-allocation-audit.test.mjs tests/sealed-unit-cost-allocation-reconciliation.test.mjs",
    "test:migration-release-guard": "node --test tests/migrate-postgres-production-guard.test.mjs",
    "pretest:records": "npm run test:purchase-accounting-audit",
    "test:records": "node --experimental-strip-types --test tests/collection-change.test.ts tests/collection-freshness-ui.test.ts tests/form-draft-lifecycle.test.ts tests/records-domain.test.ts tests/library-layout.test.ts tests/inventory-route-state.test.ts tests/navigation-intent.test.ts tests/ebay-listings-route-state.test.ts tests/ebay-listings-workspace-query.test.ts tests/ebay-listing-context.test.ts tests/copy-selection.test.ts tests/copy-selection-server-contract.test.ts tests/copy-ebay-exposure.test.ts tests/ebay-copy-exposure-presentation.test.ts tests/inventory-ebay-listing-summary-presentation.test.ts tests/ebay-copy-exposure-accessibility.test.ts tests/ebay-copy-listing-eligibility.test.ts tests/ebay-listing-lifecycle.test.ts tests/ebay-listing-backfill.test.ts tests/ebay-lot.test.ts tests/ebay-quantity-listing.test.ts tests/ebay-notification-api.test.ts tests/ebay-notification-event.test.ts tests/ebay-notification-status.test.ts tests/ebay-oauth-scopes.test.ts tests/database-error.test.ts tests/database-schema.test.ts tests/query-cache-persistence.test.ts tests/ebay-listing-timestamp.test.ts tests/expiring-single-flight-cache.test.ts tests/ebay-token-failure.test.ts tests/ebay-connection-state.test.ts tests/ebay-local-replacement-contract.test.ts tests/ebay-oauth-state.test.ts tests/ebay-listing-reconciliation-reason.test.ts tests/ebay-listing-copy-link-attention.test.ts tests/ebay-order-line-reconciliation.test.ts tests/ebay-capabilities.test.ts tests/card-printing-reconciliation.test.mjs tests/printing-identity.test.ts tests/remote-images.test.ts tests/feature-ideas-removal.test.ts",
    "test:ebay-sandbox": "node --test tests/ebay-sandbox-compatibility.test.mjs",
    "ebay:sandbox": "node scripts/ebay-sandbox-compatibility.mjs",
    "ebay:sandbox:preflight": "node scripts/ebay-sandbox-compatibility.mjs preflight",
    "price:ebay": "node scripts/price-ebay.mjs",
    "price:qcsr": "node scripts/price-qcsr-ebay.mjs",
    "cards:types": "node scripts/backfill-card-types.mjs",
    "auth:create-user": "node scripts/create-auth-user.mjs",
    "auth:set-role": "node scripts/set-auth-role.mjs",
    "db:migrate:postgres": "node scripts/migrate-sqlite-to-postgres.mjs",
    "db:push": "node --env-file-if-exists=.env.local scripts/push-database-schema.mjs",
    "db:migrate:preflight": "node --env-file-if-exists=.env.local scripts/migrate-postgres.mjs",
    "db:migrate:apply": "node --env-file-if-exists=.env.local scripts/migrate-postgres.mjs --apply",
    "db:printings:preflight": "node --env-file-if-exists=.env.local scripts/reconcile-card-printings.mjs",
    "db:printings:reconcile:apply": "node --env-file-if-exists=.env.local scripts/reconcile-card-printings.mjs --apply --confirm-reconcile-printings",
    "db:repair:ebay-composition:dry-run": "node --env-file-if-exists=.env.local scripts/repair-ebay-composition-schema.mjs",
    "db:repair:ebay-composition:apply": "node --env-file-if-exists=.env.local scripts/repair-ebay-composition-schema.mjs --apply",
    "records:purchase-accounting:dry-run": "node --env-file-if-exists=.env.local scripts/audit-ordinary-purchase-accounting.mjs",
    "records:sealed-unit-costs:dry-run": "node --env-file-if-exists=.env.local scripts/audit-sealed-unit-cost-allocations.mjs",
    "records:sealed-unit-costs:apply": "node --env-file-if-exists=.env.local scripts/reconcile-sealed-unit-cost-allocations.mjs --apply",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:studio:pg": "drizzle-kit studio --config drizzle.config.ts",
    "db:studio:sqlite": "drizzle-kit studio --config drizzle.sqlite.config.ts",
    "records:migrate:dry-run": "node scripts/migrate-library-records.mjs",
    "records:migrate:apply": "node scripts/migrate-library-records.mjs --apply",
    "inventory-images:backfill:dry-run": "node scripts/backfill-card-copy-images.mjs",
    "inventory-images:backfill:apply": "node scripts/backfill-card-copy-images.mjs --apply",
    "ebay:listings:backfill:dry-run": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/backfill-ebay-listing-composition.mjs",
    "ebay:listings:backfill:apply": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/backfill-ebay-listing-composition.mjs --apply",
    "wishlist:seed-json": "node scripts/seed-wishlist-from-combined-json.mjs",
    "wishlist:backfill-types": "node scripts/backfill-unified-card-types.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@better-auth/drizzle-adapter": "^1.6.23",
    "@tanstack/query-sync-storage-persister": "^5.101.2",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "@trpc/client": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "better-auth": "^1.6.23",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "page-flip": "^2.0.7",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "superjson": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "react-grab": "^0.1.48",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
